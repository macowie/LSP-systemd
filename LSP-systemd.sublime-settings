{
	// The command to start the language server.
	"command": ["$server_file"],

	"env": {
		// Logging configuration
		//   Valid values are: "trace", "debug", "info", "warn", "error"
		"RUST_LOG": "warn",
	},

	// The server version to install. You may need to restart after changing this setting.
	// Valid values are 'latest', a fixed version like `v2026.08.03` or to disable automatic downloads: `none'.
	"server_version": "latest",

	// base scope selectors to attach to
	"selector": "source.systemd",

	// type of buffers to attach to
	"schemes": ["file", "buffer"],
}
